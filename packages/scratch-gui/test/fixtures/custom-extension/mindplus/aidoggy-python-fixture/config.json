{
  "name": {
    "zh-cn": "AiDoggy兼容测试",
    "en": "AiDoggy compatibility fixture"
  },
  "description": {
    "zh-cn": "使用 AiDoggy 现有积木验证 Mind+ Python 用户库格式。",
    "en": "Validates the Mind+ Python package format with the existing AiDoggy blocks."
  },
  "author": "Scratch Editor Test",
  "email": "test@example.com",
  "license": "MIT",
  "isBoard": false,
  "id": "aidoggy",
  "platform": ["win", "mac", "web", "linux"],
  "version": "0.1.0",
  "scratchEditor": {
    "categories": [
      {"id": "entry", "name": "", "hideLabel": true, "blocks": ["start_thread", "start_run_thread"]},
      {
        "id": "board_resource",
        "name": "板载资源",
        "blocks": ["buzzer_tone_set", "buzzer_tone_set_arg", "get_battery_level", "set_low_battery_alarm"]
      },
      {"id": "output", "name": "输出打印", "blocks": ["print_str", "print_number"]},
      {
        "id": "motion",
        "name": "运动控制",
        "blocks": ["set_pose", "set_move", "set_move_xyz", "set_turn", "set_gait", "set_stop"]
      },
      {
        "id": "action_group",
        "name": "动作组控制",
        "blocks": ["run_action", "run_action_name", "stop_action"]
      }
    ],
    "blocks": {
      "start_thread": {
        "section": "main",
        "launcher": "Hiwonder.startMain({MAIN})"
      },
      "start_run_thread": {
        "section": "setup"
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "0.1.0",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_images/icon.svg",
        "_locales/zh-cn.json",
        "_menus/index.json"
      ]
    }
  }
}
